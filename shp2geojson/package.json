{
  "name": "shp2geojson",
  "version": "1.0.0",
  "description": "A simple CLI tool to convert Shapefile (.shp) to GeoJSON format",
  "keywords": [
    "shapefile",
    "geojson",
    "converter",
    "gis",
    "cli"
  ],
  "author": "",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=12.0.0"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "shp2geojson": "./bin/shp2geojson"
  },
  "scripts": {
    "shp2geojson": "node bin/shp2geojson",
    "convert": "node bin/shp2geojson",
    "convert:dir": "node bin/shp2geojson --json",
    "export:chat": "node scripts/export-conversation.mjs",
    "audit:chat": "node scripts/clean-chat-logs.mjs",
    "clean:chat": "node scripts/clean-chat-logs.mjs --delete",
    "test": "node bin/shp2geojson --help"
  },
  "devDependencies": {
    "mapshaper": "^0.6.113"
  }
}
